# Normalize text files in the repository; check out with the platform default.
* text=auto

# Cargo and CI files stay LF everywhere to avoid noisy lockfile diffs.
Cargo.lock text eol=lf
Cargo.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.patch text eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.exe binary
*.pdb binary
